{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arc11AblationResults",
  "type": "object",
  "required": [
    "arc",
    "harness",
    "command",
    "run_profile",
    "seeds",
    "conditions",
    "baseline_reference",
    "runs",
    "aggregated_by_condition"
  ],
  "properties": {
    "arc": { "const": "11" },
    "harness": { "const": "senna-iter-52" },
    "command": { "type": "string" },
    "run_profile": {
      "type": "object",
      "required": ["scenario_id", "agent_limit", "total_rounds", "visibility_policy"],
      "properties": {
        "scenario_id": { "type": "string" },
        "agent_limit": { "type": "integer", "minimum": 1 },
        "total_rounds": { "type": "integer", "minimum": 1 },
        "visibility_policy": { "type": "string" },
        "sampling_strategy": { "type": "string" }
      }
    },
    "seeds": { "type": "array", "items": { "type": "integer" } },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "baseline_reference": { "type": "object" },
    "runs": { "type": "array" },
    "aggregated_by_condition": { "type": "object" }
  }
}
