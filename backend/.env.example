# Senna backend — model & API configuration (single reference)
#
# Copy values into your shell before starting the backend:
#   export ANTHROPIC_API_KEY="sk-ant-..."
#   cd backend && uv run mirofish-backend
#
# Or copy this file to `.env` in this directory — Settings loads it automatically when present.
# Shell exports still override `.env` values.

# ── Default run provider (when UI leaves model on server default) ─────────────
# lmstudio | anthropic | hybrid
# hybrid = Claude on first LLM turn each round, local LM Studio for the rest
# For Anthropic-only installs, set LLM_PROVIDER=anthropic when you add ANTHROPIC_API_KEY.
# If LLM_PROVIDER is omitted and only ANTHROPIC_API_KEY is set, the backend picks anthropic.
LLM_PROVIDER=lmstudio

# ── Local LM Studio (profile: local_lmstudio_default) ───────────────────────
# Model id must match LM Studio → Local Server → loaded model name exactly
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b

# ── Anthropic / Claude (profile: anthropic_default, UI label "Claude") ───────
# Current Claude Haiku snapshot (3.5 Haiku is retired). Senna does not send temperature to Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenAI (profile: openai_default) ────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── OpenRouter (profile: openrouter_default) ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Shared LLM behaviour ──────────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ── Optional overrides ────────────────────────────────────────────────────────
# SENNA_RELOAD=1 enables uvicorn reload (dev only; reload kills in-flight simulations)
# HOST=0.0.0.0
# PORT=8100
# SQLITE_PATH=./data/mirofish.sqlite
# PEER_CONTEXT_MAX_CHARS=1200
# EMBEDDING_MODEL=
# ANTHROPIC_INPUT_PRICE_PER_MTOK=
# ANTHROPIC_OUTPUT_PRICE_PER_MTOK=
